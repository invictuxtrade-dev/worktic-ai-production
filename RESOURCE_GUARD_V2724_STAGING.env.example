# WORKTIC V27.24: SOLO EN STAGING CON BASE DE DATOS AISLADA.
# Toda funcionalidad comercial nueva permanece deshabilitada por defecto.
WORKTIC_COMMERCIAL_ENABLE=0
WORKTIC_RESOURCE_GUARD_V2724=0
# Para probar, activar ambos flags EN STAGING y configurar los cupos abajo.
# Los cupos por defecto de todos los recursos no especificados son CERO.
# MaxProducts / MaxContacts vienen de billing_plans del cliente.
# Citas simultaneas son recursos activos (no eventos mensuales).
# Las cifras siguientes son EJEMPLOS DE LABORATORIO, no promesas de planes:
# WORKTIC_APPOINTMENTS_PERSONAL_V2724=5
# WORKTIC_APPOINTMENTS_NEGOCIO_V2724=20
# WORKTIC_APPOINTMENTS_EMPRESA_V2724=50
# WORKTIC_PROFESSIONALS_PERSONAL_V2724=1
# WORKTIC_PROFESSIONALS_NEGOCIO_V2724=3
# WORKTIC_PROFESSIONALS_EMPRESA_V2724=10
# WORKTIC_SERVICES_PERSONAL_V2724=5
# WORKTIC_SERVICES_NEGOCIO_V2724=20
# WORKTIC_SERVICES_EMPRESA_V2724=40
# WORKTIC_ANALYTICS_EVENTS_PERSONAL_V2724=100
# WORKTIC_ANALYTICS_EVENTS_NEGOCIO_V2724=500
# WORKTIC_ANALYTICS_EVENTS_EMPRESA_V2724=1000
# WORKTIC_ADS_SYNCS_NEGOCIO_V2724=3
# WORKTIC_ADS_SYNCS_EMPRESA_V2724=10
# No activar bloqueo de Analytics sin retencion, alarmas y experiencia de cuota agotada.
# No activar sync Ads sin evaluar cron 6h y gastos/tarifas API de cada red.
