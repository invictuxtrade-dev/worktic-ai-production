# WorkticAI V26 - desarrollo local
APP_ENV=development
APP_NAME=Worktic AI
APP_PORT=8080
BASE_URL=http://localhost:8080
DATA_DIR=data

# Desarrollo puede continuar con SQLite. Producción V26 usa DATABASE_URL PostgreSQL.
DATABASE_DRIVER=sqlite
DATABASE_DSN=file:data/worktic.db?_pragma=foreign_keys(1)&_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)
LEGACY_WHATSAPP_DRIVER=sqlite
LEGACY_WHATSAPP_DSN=file:data/worktic.db?_pragma=foreign_keys(1)&_pragma=busy_timeout(5000)

# Redis es opcional en desarrollo; si falta, V26 usa rate limiting local.
REDIS_URL=
REDIS_REQUIRED=false
TRUST_PROXY=false
BACKGROUND_WORKERS_ENABLED=true
CHANNEL_RUNTIMES_ENABLED=true
MAINTENANCE_MODE=false

MAX_MESSAGE_LENGTH=2000
SEND_COOLDOWN_SECONDS=3
AUTO_REPLY_COOLDOWN_SECONDS=30
ALLOW_GROUP_MESSAGES=true

CHANNEL_ENCRYPTION_KEY=CAMBIA_ESTA_CLAVE_POR_UNA_ALEATORIA_DE_32_O_MAS
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

MESSENGER_VERIFY_TOKEN=cambia_este_token_seguro
WHATSAPP_VERIFY_TOKEN=cambia_este_token_seguro
META_LEADS_VERIFY_TOKEN=cambia_este_token_seguro
META_GRAPH_VERSION=v25.0
META_APP_ID=
META_APP_SECRET=
META_WHATSAPP_CONFIG_ID=
META_SYSTEM_USER_ACCESS_TOKEN=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=

TIKTOK_BUSINESS_APP_ID=
TIKTOK_BUSINESS_SECRET=
TIKTOK_BUSINESS_AUTH_URL=
GOOGLE_ADS_DEVELOPER_TOKEN=

USDT_BEP20_ADDRESS=
USDT_TRC20_ADDRESS=
PAYMENT_CONFIRMATIONS=12

MESSENGER_SYNC_ACTIVE_SECONDS=10
MESSENGER_SYNC_IDLE_SECONDS=60
MESSENGER_TOKEN_CHECK_HOURS=6
MESSENGER_OUTBOX_MAX_ATTEMPTS=5

# Opcional: example.com,api.partner.com
AUTOMATION_WEBHOOK_ALLOWED_HOSTS=
