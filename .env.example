APP_PORT=8080
APP_NAME=Worktic Omnichannel AI V6
DATABASE_DSN=file:data/worktic.db?_pragma=foreign_keys(1)&_pragma=busy_timeout(5000)
MAX_MESSAGE_LENGTH=2000
SEND_COOLDOWN_SECONDS=3
AUTO_REPLY_COOLDOWN_SECONDS=30
ALLOW_GROUP_MESSAGES=true
TELEGRAM_BOT_TOKEN=
# Esta clave la configura únicamente el propietario de Worktic. No se solicita a usuarios.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Messenger Platform (Meta)
MESSENGER_VERIFY_TOKEN=cambia_este_token_seguro
META_GRAPH_VERSION=v24.0

# Cobros USDT (configura ambas o solo la red que ofrecerás)
USDT_BEP20_ADDRESS=
USDT_TRC20_ADDRESS=
PAYMENT_CONFIRMATIONS=12

# Clave aleatoria de 32+ caracteres. No la cambies sin migrar credenciales.
CHANNEL_ENCRYPTION_KEY=CAMBIA_ESTA_CLAVE_POR_UNA_ALEATORIA_MUY_LARGA
