APP_PORT=8080
APP_NAME=Worktic AI V13.1 Team WhatsApp Premium
DATABASE_DSN=file:data/worktic.db?_pragma=foreign_keys(1)&_pragma=busy_timeout(5000)
MAX_MESSAGE_LENGTH=2000
SEND_COOLDOWN_SECONDS=3
AUTO_REPLY_COOLDOWN_SECONDS=30
ALLOW_GROUP_MESSAGES=true
TELEGRAM_BOT_TOKEN=
# Esta clave la configura únicamente el propietario de Worktic. No se solicita a usuarios.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Messenger Platform (Meta)
MESSENGER_VERIFY_TOKEN=cambia_este_token_seguro
META_GRAPH_VERSION=v25.0

# Cobros USDT (configura ambas o solo la red que ofrecerás)
USDT_BEP20_ADDRESS=
USDT_TRC20_ADDRESS=
PAYMENT_CONFIRMATIONS=12

# Clave aleatoria de 32+ caracteres. No la cambies sin migrar credenciales.
CHANNEL_ENCRYPTION_KEY=CAMBIA_ESTA_CLAVE_POR_UNA_ALEATORIA_MUY_LARGA

# Social Hub - OAuth oficial
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe ser una URL pública HTTPS en producción
# BASE_URL=https://app.tudominio.com

# Messenger production hardening
MESSENGER_SYNC_ACTIVE_SECONDS=10
MESSENGER_SYNC_IDLE_SECONDS=60
MESSENGER_TOKEN_CHECK_HOURS=6
MESSENGER_OUTBOX_MAX_ATTEMPTS=5
