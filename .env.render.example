# WorkticAI V26 - Render Production
APP_ENV=production
APP_NAME=Worktic AI
BASE_URL=https://app.workticai.com
DATA_DIR=/var/data

# PostgreSQL principal - Render debe inyectarlo desde worktic-db
DATABASE_DRIVER=postgres
DATABASE_URL=postgresql://worktic:SECRET@INTERNAL_HOST/worktic

# Redis / Key Value - Render debe inyectarlo desde worktic-cache
REDIS_URL=redis://INTERNAL_HOST:6379
REDIS_REQUIRED=true
TRUST_PROXY=true
BACKGROUND_WORKERS_ENABLED=true
CHANNEL_RUNTIMES_ENABLED=true

# SOLO durante el corte V25/original -> V26: true; después false o eliminar
MAINTENANCE_MODE=false

# WhatsApp QR heredado permanece en el persistent disk durante V26
LEGACY_WHATSAPP_DRIVER=sqlite
LEGACY_WHATSAPP_DSN=file:/var/data/worktic.db?_pragma=foreign_keys(1)&_pragma=busy_timeout(5000)

# Seguridad. NO cambiar esta clave después de cifrar credenciales sin migrarlas.
CHANNEL_ENCRYPTION_KEY=GENERA_UN_SECRETO_ALEATORIO_DE_64_CARACTERES

# SOLO para instalaciones nuevas sin usuarios. Eliminar ambas tras el primer arranque.
# BOOTSTRAP_ADMIN_EMAIL=owner@empresa.com
# BOOTSTRAP_ADMIN_PASSWORD=UNA_CLAVE_LARGA_DE_12_O_MAS

# IA
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Meta: Facebook, Instagram, Messenger, WhatsApp Cloud, Lead Ads
META_GRAPH_VERSION=v25.0
META_APP_ID=
META_APP_SECRET=
MESSENGER_VERIFY_TOKEN=GENERA_UN_TOKEN_ALEATORIO
WHATSAPP_VERIFY_TOKEN=GENERA_UN_TOKEN_ALEATORIO
META_LEADS_VERIFY_TOKEN=GENERA_UN_TOKEN_ALEATORIO
META_WHATSAPP_CONFIG_ID=
# Opcional para operaciones de Tech Provider / sistema
META_SYSTEM_USER_ACCESS_TOKEN=

# Social Hub
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=

# Ads Center V25
TIKTOK_BUSINESS_APP_ID=
TIKTOK_BUSINESS_SECRET=
TIKTOK_BUSINESS_AUTH_URL=
GOOGLE_ADS_DEVELOPER_TOKEN=

# Facturación
USDT_BEP20_ADDRESS=
USDT_TRC20_ADDRESS=
PAYMENT_CONFIRMATIONS=12

# Mensajería / workers
MAX_MESSAGE_LENGTH=2000
SEND_COOLDOWN_SECONDS=3
AUTO_REPLY_COOLDOWN_SECONDS=30
ALLOW_GROUP_MESSAGES=false
MESSENGER_SYNC_ACTIVE_SECONDS=10
MESSENGER_SYNC_IDLE_SECONDS=60
MESSENGER_TOKEN_CHECK_HOURS=6
MESSENGER_OUTBOX_MAX_ATTEMPTS=5

# Emergencia únicamente; NO dejar activo en producción normal
# ALLOW_SQLITE_PRODUCTION=false

# Opcional: limita Automation Webhooks a dominios concretos (coma-separados).
# Si se deja vacío, V26 permite únicamente destinos HTTPS públicos y bloquea redes privadas/reservadas.
AUTOMATION_WEBHOOK_ALLOWED_HOSTS=
